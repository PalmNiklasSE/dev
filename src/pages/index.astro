---
import '../styles/global.css';

const projects = [
  {
    name: 'Fieldnotes',
    type: 'Concept · Identity & editorial',
    className: 'project-art--fieldnotes',
  },
  {
    name: 'Form / Function',
    type: 'Product exploration · UX/UI',
    className: 'project-art--form',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A multidisciplinary designer making thoughtful digital experiences, identities, and ideas."
    />
    <meta name="theme-color" content="#f4f3ef" />
    <title>Portfolio — Independent Designer & Developer</title>
  </head>
  <body>
    <header class="site-header">
      <div class="page-shell flex h-full items-center justify-between">
        <a class="brand" href="#top">Niklas Palm</a>
        <nav class="flex items-center gap-8" aria-label="Main navigation">
          <a class="nav-link" href="#work">Work</a>
          <a class="nav-link" href="#about">About</a>
          <a class="nav-link" href="#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="hero page-shell" aria-labelledby="hero-title">
        <p class="hero-kicker eyebrow">Independent designer & developer</p>
        <h1 class="hero-title" id="hero-title">
          Thoughtful design.<br />
          <span>Made to move.</span>
        </h1>
        <div class="hero-bottom flex items-end justify-between gap-8">
          <p class="hero-description">
            I turn good ideas into considered identities, digital experiences, and
            things that work beautifully.
          </p>
          <a class="text-link" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
        </div>
      </section>

      <section class="work-section page-shell section-rule" id="work" aria-labelledby="work-title">
        <div class="section-heading flex items-end justify-between gap-6">
          <div>
            <p class="eyebrow section-index">01 / Selected work</p>
            <h2 id="work-title">A few good things.</h2>
          </div>
          <span class="section-index">Selected projects</span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <article class="project-card">
                <div
                  class:list={['project-art', project.className]}
                  role="img"
                  aria-label={`${project.name} project artwork`}
                >
                  {index === 0 ? (
                    <div class="fieldnotes-card" aria-hidden="true">
                      <span class="fieldnotes-title">field<br />notes</span>
                      <span class="fieldnotes-footer">A study in slowing down</span>
                    </div>
                  ) : (
                    <>
                      <div class="form-symbol" aria-hidden="true"></div>
                      <span class="form-wordmark" aria-hidden="true">FORM / FUNCTION</span>
                    </>
                  )}
                </div>
                <div class="project-meta flex items-baseline justify-between gap-4">
                  <h3>{project.name}</h3>
                  <p>{project.type}</p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="about-section page-shell section-rule" id="about" aria-labelledby="about-title">
        <p class="eyebrow section-index" id="about-title">02 / A little about me</p>
        <div class="about-body">
          <figure class="about-portrait">
            <img
              src="https://github.com/user-attachments/assets/b6e18017-95ed-4e7e-aa1c-6c6e29e760b7"
              alt="Black-and-white portrait of the portfolio owner"
              width="1122"
              height="1402"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <p class="about-copy">
            Good work starts with <span>curiosity</span>, gets better through
            collaboration, and earns its place by making a difference.
          </p>
        </div>
      </section>

      <section class="contact-section page-shell section-rule" id="contact" aria-labelledby="contact-title">
        <div>
          <p class="eyebrow section-index">03 / Have something in mind?</p>
          <h2 id="contact-title">Let’s make it<br />mean something.</h2>
        </div>
        <a class="text-link" href="mailto:hello@example.com">
          Start a conversation <span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer class="site-footer page-shell flex items-center justify-between">
      <nav class="footer-social flex items-center gap-6" aria-label="Social links">
        <a class="nav-link" href="https://www.linkedin.com/in/niklas-palm-053671139">LinkedIn</a>
        <a class="nav-link" href="https://github.com/PalmNiklasSE">GitHub</a>
      </nav>
      <a class="nav-link" href="#top">Back to top ↑</a>
    </footer>
  </body>
</html>
